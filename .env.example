# Port binding on the host. Change if 3068 is already taken.
MCP_PORT=3068

# --- Authorization server (e.g. your auth-center OAuth issuer) ---
# Issuer URL of the OAuth 2.1 / OIDC authorization server that will issue
# access tokens for this MCP server. No default: the server refuses to start
# without it so it never silently points at someone else's IdP.
# Discovered via OIDC: {OAUTH_ISSUER_URL}/.well-known/openid-configuration
# must be reachable and its "jwks_uri" must serve the signing keys.
OAUTH_ISSUER_URL=https://auth.example.com
# Signing algorithm(s) your authorization server uses, space/comma separated.
OAUTH_SIGNING_ALGS=RS256
# Scopes required to call the MCP tools.
OAUTH_REQUIRED_SCOPES=notes:read notes:write

# --- This MCP server's own identity ---
# The resource identifier (OAuth audience) clients must request tokens for.
# Must be the exact URL your MCP client (e.g. MCP Inspector) uses to reach
# this server, and must exactly match what you register as the "API
# resource" / audience on your authorization server. When running via
# `docker compose` with the default port mapping, that's the host-visible
# address below, NOT the Docker-internal "mcp:8080" hostname — a client
# outside the compose network can't resolve that name, and the MCP
# Authorization spec requires the resource to match what the client
# actually connected to.
MCP_RESOURCE_URL=http://localhost:3068/mcp
# Human-readable name returned in the protected-resource metadata.
OAUTH_RESOURCE_NAME=MCP OAuth Demo
# MCP server implementation identity (as reported over the MCP protocol).
MCP_SERVER_NAME=mcp-oauth-demo
MCP_SERVER_VERSION=1.0.0
